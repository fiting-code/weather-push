# ============================================================
# 天气推送服务 - 环境变量样例
# 使用方式: cp .env.example .env 后填写真实值
# 注意: .env 已被 .gitignore 排除，切勿提交到仓库
# 本文件中所有值均为占位符，不含任何真实密钥
# ============================================================

# ---------- 1. 运行时 ----------
# 日志级别: debug | info | warn | error
LOG_LEVEL=info
# 时区，所有日期计算与展示均以此为准
TZ=Asia/Shanghai

# ---------- 2. 天气数据源 ----------
# 数据源: qweather(和风天气, 需 API KEY, 字段最全) | open-meteo(免密钥, 便于零配置调试)
WEATHER_PROVIDER=qweather

# 和风天气控制台 -> 项目管理 -> 凭据
WEATHER_API_BASE=https://devapi.qweather.com/v7
WEATHER_API_KEY=YOUR_QWEATHER_API_KEY_HERE
# 可选: 若控制台创建的是 ED25519 类型的凭据, 需填下面三项走 JWT 鉴权
# (私钥请放在私钥文件里, 通过 WEATHER_JWT_KEY_PATH 指定路径, 不要直接写内容到 .env)
WEATHER_JWT_KEY_ID=
WEATHER_JWT_SUB=
WEATHER_JWT_KEY_PATH=

# Open-Meteo 免密钥数据源(无需填写任何凭据)
OPEN_METEO_BASE=https://api.open-meteo.com/v1
OPEN_METEO_AIR_BASE=https://air-quality-api.open-meteo.com/v1

# ---------- 3. 推送渠道 ----------
# 渠道: pushplus | wecom | serverchan
PUSH_CHANNEL=pushplus

# 3.1 PushPlus (pushplus.plus) —— 微信扫码登录后在官网复制 token
PUSHPLUS_TOKEN=YOUR_PUSHPLUS_TOKEN_HERE
# txt(纯文本,\n 换行) | html | json | markdown; 手机端可读性最好的是 txt
PUSHPLUS_TEMPLATE=txt
# 可选: 群组编码, 留空=一对一推送; 一对多群组需会员
PUSHPLUS_TOPIC=

# 3.2 企业微信应用消息
WECOM_CORP_ID=YOUR_CORP_ID_HERE
WECOM_CORP_SECRET=YOUR_APP_SECRET_HERE
WECOM_AGENT_ID=1000002
# 接收成员账号, 多个用 | 分隔; @all 表示应用可见范围内全体成员
WECOM_TO_USER=@all

# 3.3 Server酱 Turbo (sctapi.ftqq.com)
SERVERCHAN_SEND_KEY=YOUR_SERVERCHAN_SEND_KEY_HERE

# ---------- 4. 重试与超时 ----------
# 接口失败后的最大重试次数(不含首次请求), 指数退避 1s -> 2s -> 4s
MAX_RETRIES=3
# 单次 HTTP 请求超时(毫秒)
REQUEST_TIMEOUT_MS=10000
# 推送重试时的额外退避基数(毫秒), 避免与天气接口同时打满
RETRY_BASE_DELAY_MS=1000

# ---------- 5. 消息长度 ----------
# 单条消息最大字符数(超出按行裁剪, 优先保留核心天气行)
MAX_MESSAGE_CHARS=800
